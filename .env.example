# Copy to .env for local development. Production and preview values are set
# in Cloudflare (Workers secrets and variables), not here.

# Seals the session cookies. At least 32 random characters, e.g.
# `openssl rand -base64 32`. Production and previews each use their own.
NUXT_SESSION_PASSWORD=

# Google sign-in (Google Cloud console, OAuth client of type "Web application").
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Resend, for order, password and confirmation emails. Leave empty locally to
# skip sending: the server logs "RESEND_API_KEY is not set" instead.
NUXT_RESEND_API_KEY=

# Receives the new-order notifications and the contact form.
NUXT_ADMIN_EMAIL=

# The base of every link in emails and of the canonical and share URLs.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. These are Cloudflare's public test keys, which always
# pass; production uses the real keys.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Uploads source maps to Sentry during a production build. Not needed locally.
SENTRY_AUTH_TOKEN=
