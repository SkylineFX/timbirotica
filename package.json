{
  "name": "timbirotica",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:fts": "npx tsx scripts/apply-search-fts.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "typecheck": "nuxi typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.3.0",
    "@nuxthub/core": "^0.10.4",
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/sitemap": "^8.0.15",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-email/render": "^2.0.8",
    "@sentry/nuxt": "^11.17.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.2.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "maska": "^3.2.0",
    "nuxt": "^4.2.2",
    "nuxt-auth-utils": "^0.5.34",
    "nuxt-email-renderer": "^2.6.0",
    "pdf-lib": "^1.17.1",
    "resend": "^6.12.2",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/schema": "~4.4.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.14"
